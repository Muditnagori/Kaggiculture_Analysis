# ==============================================================================
# SENSITIVE / CREDENTIALS / LOGIN SESSIONS (NEVER UPLOAD!)
# ==============================================================================
# Kaggle login session (Playwright storage_state with cookies) -> replay_downloader/auth.json
auth.json
**/auth.json
*auth*.json
!**/auth.json.example
*cookie*
*session*.json
storage_state*.json
credentials.json
token.json
kaggle.json
.env
.env.*
*.key
*.pem
# Personal identity / agent rules (contain account emails)
.agents/

# ==============================================================================
# HISTORY / DATABASES (NEVER UPLOAD!)
# ==============================================================================
# Persistent download history registry -> replay_downloader/download_history.db
download_history.*
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ==============================================================================
# DATA / DOWNLOADS / REPLAYS / GENERATED OUTPUTS (DO NOT UPLOAD!)
# ==============================================================================
downloads/
**/downloads/
*.zip
*.parquet
*.csv
*.json.gz
*.tar.gz
**/formatted_data/
**/player_moves/
**/outputs/
**/inputs/
replay_formatter/**/_parts/
# Generated player text reports
/data/
route_catalog/catalog.json
.system_generated/
Kaggiculture_Analysis/

